# =============================================================================
# PAC UFPI — Variáveis de Ambiente (exemplo)
# Copie este arquivo para .env e ajuste os valores conforme necessário.
# =============================================================================

DEBUG=True
SECRET_KEY=change-me-in-production

# Banco de dados: SQLite (arquivo local db.sqlite3, sem configuração extra).

# Hosts permitidos (separados por vírgula)
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens permitidas para o front-end React (CORS), separadas por vírgula.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
